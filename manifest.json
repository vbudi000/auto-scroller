{
  "manifest_version": 3,
  "name": "Auto Scroller",
  "version": "1.2.0",
  "description": "Automatically scrolls the current page at a configurable speed and distance.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "block_iframes",
        "enabled": true,
        "path": "rules/block_iframes.json"
      }
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
